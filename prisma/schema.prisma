generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  wallet             String    @unique
  createdAt          DateTime  @default(now())
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActivityDate   DateTime?
  totalContributions Int       @default(0)
  totalSaved         String    @default("0")
  invitedMembers     Int       @default(0)
  circlesCompleted   Int       @default(0)
  ownedCircles       Circle[]  @relation("CircleOwner")
  memberCircles      Circle[]  @relation("CircleMembers")
}

model Circle {
  id                   String             @id @default(uuid())
  name                 String
  description          String?
  targetAmount         String
  contributionAmount   String
  contributionInterval String
  durationDays         String
  isPublic             Boolean            @default(false)
  transactionHash      String?
  ownerId              String
  onChainId            Int?               @unique
  contractAddress      String?
  syncStatus           String             @default("PENDING")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  owner                User               @relation("CircleOwner", fields: [ownerId], references: [id])
  invitations          CircleInvitation[]
  invites              Invite[]
  PaymentSchedule      PaymentSchedule[]
  members              User[]             @relation("CircleMembers")
}

model Invite {
  id        String   @id @default(uuid())
  circleId  String
  email     String
  token     String   @unique
  expiresAt DateTime
  claimed   Boolean  @default(false)
  circle    Circle   @relation(fields: [circleId], references: [id])
}

model CircleInvitation {
  id                      String    @id @default(uuid())
  circleId                String
  inviterEmail            String
  inviteeEmail            String?
  inviteeWalletAddress    String?
  inviteType              String
  status                  String    @default("PENDING")
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  acceptedAt              DateTime?
  acceptedByEmail         String?
  acceptedByWalletAddress String?
  circle                  Circle    @relation(fields: [circleId], references: [id])

  @@index([inviteeEmail])
  @@index([inviteeWalletAddress])
  @@index([circleId])
}

model UserActivity {
  id          String   @id @default(uuid())
  userAddress String
  type        String
  description String?
  metadata    String?
  timestamp   DateTime @default(now())

  @@index([userAddress])
  @@index([type])
  @@index([timestamp])
}

model PaymentSchedule {
  id               String             @id @default(uuid())
  userAddress      String
  circleId         String
  amount           String
  frequency        String
  nextPaymentDate  DateTime
  lastPaymentDate  DateTime?
  isActive         Boolean            @default(true)
  totalPayments    Int                @default(0)
  maxPayments      Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Circle           Circle             @relation(fields: [circleId], references: [id])
  RecurringPayment RecurringPayment[]

  @@index([circleId])
  @@index([isActive])
  @@index([nextPaymentDate])
  @@index([userAddress])
}

model RecurringPayment {
  id              String          @id @default(uuid())
  scheduleId      String
  userAddress     String
  circleId        String
  amount          String
  status          String
  transactionHash String?
  scheduledFor    DateTime
  processedAt     DateTime?
  failureReason   String?
  retryCount      Int             @default(0)
  createdAt       DateTime        @default(now())
  PaymentSchedule PaymentSchedule @relation(fields: [scheduleId], references: [id])

  @@index([scheduleId])
  @@index([scheduledFor])
  @@index([status])
  @@index([userAddress])
}

model StreakData {
  id               String    @id @default(uuid())
  userAddress      String    @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  streakType       String    @default("CONTRIBUTION")

  @@index([userAddress])
}
