generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User profiles - needed because blockchain doesn't store emails
model User {
  id                 String    @id @default(uuid())
  wallet             String    @unique            // From Dynamic wallet connection
  email              String    @unique            // From Dynamic for email invitations
  name               String?                      // Display name from Dynamic
  createdAt          DateTime  @default(now())
  
  // Streak tracking (calculated from UserActivity)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActivityDate   DateTime?
  
  // Stats (calculated from blockchain events)
  totalContributions Int       @default(0)
  totalSaved         String    @default("0")     // BigInt as string
  invitedMembers     Int       @default(0)
  circlesCompleted   Int       @default(0)
  
  // Relations
  ownedCircles       Circle[]  @relation("CircleOwner")
  invitations        CircleInvitation[]
}

// Cache blockchain circle data for UI performance
model Circle {
  id                   String             @id @default(uuid())
  onChainId            Int?               @unique  // From Grove.sol after creation
  transactionHash      String?                     // Circle creation tx
  
  // Smart contract data (synced from Grove.sol)
  name                 String
  description          String?
  targetAmount         String                      // BigInt as string
  contributionAmount   String                      // BigInt as string
  contributionInterval String                      // Seconds as string
  durationDays         String                      // Days as string
  isPublic             Boolean            @default(false)
  
  // Database specific
  ownerId              String
  syncStatus           String             @default("PENDING") // PENDING, SYNCED, FAILED
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  
  // Relations
  owner                User               @relation("CircleOwner", fields: [ownerId], references: [id])
  invitations          CircleInvitation[]
}

// Email invitations (before blockchain join)
model CircleInvitation {
  id              String    @id @default(uuid())
  circleId        String
  inviterWallet   String     // Who sent invitation
  recipientEmail  String     // Email to invite
  token           String     @unique  // Unique invite link token
  status          String     @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
  
  // Relations
  circle          Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  inviter         User      @relation(fields: [inviterWallet], references: [wallet])
  
  @@index([recipientEmail])
  @@index([circleId])
}

// Cache blockchain events for dashboard/leaderboard
model UserActivity {
  id              String   @id @default(uuid())
  userWallet      String                        // User's wallet address
  activityType    String                        // "contribution", "circle_joined", "circle_created"
  circleId        String?                       // Related circle (if applicable)
  amount          String?                       // Amount for contributions (BigInt as string)
  transactionHash String?                       // Blockchain transaction hash
  blockNumber     String?                       // Block number for ordering
  timestamp       DateTime @default(now())
  metadata        Json?                         // Additional activity data
  
  @@index([userWallet])
  @@index([activityType])
  @@index([timestamp])
}
