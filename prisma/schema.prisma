// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  wallet    String   @unique
  createdAt DateTime @default(now())
  
  // Phase 2: Streak Tracking
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastActivityDate   DateTime?
  totalContributions Int      @default(0)
  totalSaved         String   @default("0") // Stored as string for bigint
  invitedMembers     Int      @default(0)
  circlesCompleted   Int      @default(0)
  
  ownedCircles Circle[] @relation("CircleOwner")
  memberCircles Circle[] @relation("CircleMembers")
}

model Circle {
  id            String   @id @default(uuid()) // UUID primary key
  name          String
  description   String?
  targetAmount  String   // Stored as string to handle bigint
  paymentType   String   // "ONETIME" or "RECURRING"
  fixedAmount   String?  // Stored as string to handle bigint
  frequency     String?  // "DAILY", "WEEKLY", "MONTHLY" (for recurring circles)
  deadline      DateTime
  transactionHash String?
  owner         User     @relation("CircleOwner", fields: [ownerId], references: [id])
  ownerId       String
  members       User[]   @relation("CircleMembers")
  invites       Invite[] // Legacy invites
  invitations   CircleInvitation[] // New invitation system
  paymentSchedules PaymentSchedule[] // Recurring payment schedules
  onChainId     Int?     @unique // Maps to contract's circleId (unique)
  contractAddress String? // Which Grove contract this circle belongs to
  syncStatus    String   @default("PENDING") // "PENDING", "SYNCED", "FAILED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invite {
  id        String   @id @default(uuid())
  circle    Circle   @relation(fields: [circleId], references: [id])
  circleId  String   // Changed from Int to String to match Circle.id
  email     String
  token     String   @unique
  expiresAt DateTime
  claimed   Boolean  @default(false)
}

model CircleInvitation {
  id                      String   @id @default(uuid())
  circleId                String   // Changed from Int to String to match Circle.id
  circle                  Circle   @relation(fields: [circleId], references: [id])
  inviterEmail            String
  inviteeEmail            String?  // For email invitations
  inviteeWalletAddress    String?  // For direct wallet invitations
  inviteType              String   // "EMAIL" or "WALLET"
  status                  String   @default("PENDING") // "PENDING", "ACCEPTED", "DECLINED", "EXPIRED"
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  acceptedAt              DateTime?
  acceptedByEmail         String?
  acceptedByWalletAddress String?
  
  @@index([inviteeEmail])
  @@index([inviteeWalletAddress])
  @@index([circleId])
}

model UserActivity {
  id          String   @id @default(uuid())
  userAddress String
  type        String   // ActivityType enum values
  description String?
  metadata    String?  // JSON string for flexible data storage
  timestamp   DateTime @default(now())
  
  @@index([userAddress])
  @@index([type])
  @@index([timestamp])
}

model PaymentSchedule {
  id              String   @id @default(uuid())
  userAddress     String
  circleId        String
  circle          Circle   @relation(fields: [circleId], references: [id])
  amount          String   // Amount in wei/satoshis as string
  frequency       String   // "DAILY", "WEEKLY", "MONTHLY"
  nextPaymentDate DateTime
  lastPaymentDate DateTime?
  isActive        Boolean  @default(true)
  totalPayments   Int      @default(0)
  maxPayments     Int?     // Optional limit on number of payments
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  payments RecurringPayment[]
  
  @@index([userAddress])
  @@index([circleId])
  @@index([nextPaymentDate])
  @@index([isActive])
}

model RecurringPayment {
  id                String          @id @default(uuid())
  scheduleId        String
  schedule          PaymentSchedule @relation(fields: [scheduleId], references: [id])
  userAddress       String
  circleId          String
  amount            String          // Amount in wei/satoshis as string
  status            String          // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  transactionHash   String?
  scheduledFor      DateTime        // When this payment was scheduled to execute
  processedAt       DateTime?       // When the payment was actually processed
  failureReason     String?
  retryCount        Int             @default(0)
  createdAt         DateTime        @default(now())
  
  @@index([scheduleId])
  @@index([userAddress])
  @@index([status])
  @@index([scheduledFor])
}

model StreakData {
  id                String   @id @default(uuid())
  userAddress       String   @unique
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastActivityDate  DateTime?
  streakType        String   @default("CONTRIBUTION") // "CONTRIBUTION", "LOGIN", "ANY"
  
  @@index([userAddress])
}