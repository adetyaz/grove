// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  wallet    String   @unique
  createdAt DateTime @default(now())
  
  // Phase 2: Streak Tracking
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastActivityDate   DateTime?
  totalContributions Int      @default(0)
  totalSaved         String   @default("0") // Stored as string for bigint
  invitedMembers     Int      @default(0)
  circlesCompleted   Int      @default(0)
  
  ownedCircles Circle[] @relation("CircleOwner")
  memberCircles Circle[] @relation("CircleMembers")
}

model Circle {
  id            String   @id @default(uuid()) // UUID primary key
  name          String
  description   String?
  targetAmount  String   
  paymentType   String 
  fixedAmount   String?  
  frequency     String?  
  deadline      DateTime
  transactionHash String?
  owner         User     @relation("CircleOwner", fields: [ownerId], references: [id])
  ownerId       String
  members       User[]   @relation("CircleMembers")
  invites       Invite[]
  invitations   CircleInvitation[]
  paymentSchedules PaymentSchedule[]
  onChainId     Int?     @unique
  contractAddress String?
  syncStatus    String   @default("PENDING") 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invite {
  id        String   @id @default(uuid())
  circle    Circle   @relation(fields: [circleId], references: [id])
  circleId  String   
  email     String
  token     String   @unique
  expiresAt DateTime
  claimed   Boolean  @default(false)
}

model CircleInvitation {
  id                      String   @id @default(uuid())
  circleId                String  
  circle                  Circle   @relation(fields: [circleId], references: [id])
  inviterEmail            String
  inviteeEmail            String?  
  inviteeWalletAddress    String?  
  inviteType              String   
  status                  String   @default("PENDING")
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  acceptedAt              DateTime?
  acceptedByEmail         String?
  acceptedByWalletAddress String?
  
  @@index([inviteeEmail])
  @@index([inviteeWalletAddress])
  @@index([circleId])
}

model UserActivity {
  id          String   @id @default(uuid())
  userAddress String
  type        String 
  description String?
  metadata    String?
  timestamp   DateTime @default(now())
  
  @@index([userAddress])
  @@index([type])
  @@index([timestamp])
}

model PaymentSchedule {
  id              String   @id @default(uuid())
  userAddress     String
  circleId        String
  circle          Circle   @relation(fields: [circleId], references: [id])
  amount          String
  frequency       String
  nextPaymentDate DateTime
  lastPaymentDate DateTime?
  isActive        Boolean  @default(true)
  totalPayments   Int      @default(0)
  maxPayments     Int?    
  suspendedUntil  DateTime? 
  terminatedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  payments RecurringPayment[]
  
  @@index([userAddress])
  @@index([circleId])
  @@index([nextPaymentDate])
  @@index([isActive])
}

model RecurringPayment {
  id                String          @id @default(uuid())
  scheduleId        String
  schedule          PaymentSchedule @relation(fields: [scheduleId], references: [id])
  userAddress       String
  circleId          String
  amount            String         
  status            String         
  transactionHash   String?
  scheduledFor      DateTime       
  processedAt       DateTime?       
  failureReason     String?
  retryCount        Int             @default(0)
  createdAt         DateTime        @default(now())
  
  @@index([scheduleId])
  @@index([userAddress])
  @@index([status])
  @@index([scheduledFor])
}

model StreakData {
  id                String   @id @default(uuid())
  userAddress       String   @unique
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastActivityDate  DateTime?
  streakType        String   @default("CONTRIBUTION") 
  
  @@index([userAddress])
}


model GiftClaimInvite {
  id               String   @id @default(uuid())
  giftId           String   
  recipientEmail   String
  senderAddress    String
  senderName       String?
  circleId         String
  circleName       String
  amount           String   
  message          String?
  occasion         String? 
  claimToken       String   @unique 
  emailSent        Boolean  @default(false)
  emailSentAt      DateTime?
  claimedAt        DateTime?
  claimedByAddress String?  
  expiresAt        DateTime 
  createdAt        DateTime @default(now())
  
  @@index([recipientEmail])
  @@index([claimToken])
  @@index([senderAddress])
  @@index([circleId])
  @@index([expiresAt])
}

// PUNISHMENT SYSTEM TABLES
model UserViolation {
  id          String   @id @default(uuid())
  userAddress String
  circleId    String
  type        String  
  description String?
  metadata    String? 
  createdAt   DateTime @default(now())
  
  punishments UserPunishment[]
  
  @@index([userAddress])
  @@index([circleId])
  @@index([type])
  @@index([createdAt])
}

model UserPunishment {
  id           String        @id @default(uuid())
  userAddress  String
  circleId     String
  violationId  String
  violation    UserViolation @relation(fields: [violationId], references: [id])
  type         String
  severity     Int
  description  String
  status       String        @default("ACTIVE") 
  appliedAt    DateTime      @default(now())
  expiresAt    DateTime?     
  fineAmount   String?       
  appealAllowed Boolean      @default(true)
  
  appeals PunishmentAppeal[]
  
  @@index([userAddress])
  @@index([circleId])
  @@index([status])
  @@index([type])
}

model PunishmentAppeal {
  id           String         @id @default(uuid())
  userAddress  String
  punishmentId String
  punishment   UserPunishment @relation(fields: [punishmentId], references: [id])
  circleId     String
  reason       String
  evidence     String?
  status       String         @default("PENDING") 
  submittedAt  DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?        
  reviewNotes  String?
  
  @@index([userAddress])
  @@index([punishmentId])
  @@index([status])
}

model PunishmentApproval {
  id             String   @id @default(uuid())
  userAddress    String
  circleId       String
  violationId    String
  punishmentType String
  severity       Int
  description    String
  status         String   @default("PENDING") 
  queuedAt       DateTime @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  appealAllowed  Boolean  @default(true)
  metadata       String? 
  
  @@index([userAddress])
  @@index([status])
  @@index([queuedAt])
}

model UserSuspension {
  id          String    @id @default(uuid())
  userAddress String
  circleId    String
  reason      String
  suspendedAt DateTime  @default(now())
  expiresAt   DateTime
  liftedAt    DateTime?
  isActive    Boolean   @default(true)
  
  @@index([userAddress])
  @@index([circleId])
  @@index([isActive])
  @@index([expiresAt])
}

model ContributionHold {
  id          String    @id @default(uuid())
  userAddress String
  circleId    String
  reason      String
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  isActive    Boolean   @default(true)
  
  @@index([userAddress])
  @@index([circleId])
  @@index([isActive])
}