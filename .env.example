# Grove Environment Variables
# Copy this file to .env.local and fill in your actual values

# Dynamic.xyz Environment ID (required for wallet connections)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id_here

# Database URL for Prisma (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/grove_db?schema=public"

# Optional: API Keys for external services
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Email service (if using Nodemailer)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
